<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TGACH - Select Region</title>
    <meta name="description" content="TGACH - Select your region: Russian, English, or Japanese stream of the anonymous forum archive.">
    <meta property="og:site_name" content="TGACH">
    <meta property="og:type" content="website">
    <meta property="og:title" content="TGACH - Select Region">
    <meta property="og:description" content="TGACH - Select your region: Russian, English, or Japanese stream of the anonymous forum archive.">
    <meta property="og:image" content="/static/logo.png">
    <style>
        :root {
            --bg-color: #0f0f11;
            --card-bg: #1a1a1d;
            --text-main: #ffffff;
            --text-sub: #888888;
            --accent-ru: #e74c3c;
            --accent-en: #3498db;
            --accent-jp: #e91e63;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            text-align: center;
            animation: fadeIn 0.8s ease-out;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 10px;
            letter-spacing: -1px;
        }

        .subtitle {
            color: var(--text-sub);
            margin-bottom: 50px;
            font-size: 1.1rem;
        }

        .lang-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        /* --- CARD DESIGN --- */
        .lang-card {
            background-color: var(--card-bg);
            border-radius: 20px;
            padding: 30px;
            text-decoration: none;
            color: inherit;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .lang-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.05), transparent);
            transform: translateX(-100%);
            transition: 0.5s;
        }

        .lang-card:hover::before {
            transform: translateX(100%);
        }

        .lang-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            border-color: rgba(255, 255, 255, 0.1);
        }

        /* --- FLAGS (FIXED) --- */
        .flag-wrapper {
            width: 90px;  /* Ширина прямоугольника */
            height: 60px; /* Высота прямоугольника (3:2) */
            border-radius: 6px; /* Аккуратные уголки */
            margin-bottom: 25px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            background: transparent; /* Убран черный фон */
            /* Чтобы флаг заполнял всё пространство */
            display: flex; 
            align-items: center; 
            justify-content: center;
        }

        .flag-svg {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Заполняет весь прямоугольник */
            display: block;
        }

        /* Анимация флагов для EN */
        .flag-slideshow {
            position: relative;
            width: 100%;
            height: 100%;
        }
        
        .flag-slide {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            opacity: 0;
            animation: flagFade 9s infinite;
        }
        
        .flag-slide:nth-child(1) { animation-delay: 0s; } /* US */
        .flag-slide:nth-child(2) { animation-delay: 3s; } /* UK */
        .flag-slide:nth-child(3) { animation-delay: 6s; } /* EU */

        @keyframes flagFade {
            0% { opacity: 0; transform: scale(1.1); }
            10% { opacity: 1; transform: scale(1); }
            33% { opacity: 1; transform: scale(1); }
            43% { opacity: 0; transform: scale(0.9); }
            100% { opacity: 0; }
        }

        /* --- TEXT --- */
        .lang-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .lang-phrase {
            font-size: 1rem;
            color: var(--text-sub);
            font-weight: 500;
        }

        /* --- HOVER ACCENTS --- */
        .card-ru:hover .lang-name { color: var(--accent-ru); }
        .card-en:hover .lang-name { color: var(--accent-en); }
        .card-jp:hover .lang-name { color: var(--accent-jp); }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Mobile Adjustments */
        @media (max-width: 768px) {
            h1 { font-size: 2rem; }
            .lang-grid { grid-template-columns: 1fr; gap: 15px; }
            .lang-card { padding: 20px; display: grid; grid-template-columns: 70px 1fr; align-items: center; text-align: left; gap: 20px; }
            .flag-wrapper { margin-bottom: 0; width: 70px; height: 46px; }
            .lang-name { margin-bottom: 0; font-size: 1.3rem; }
            .lang-phrase { font-size: 0.9rem; }
        }

        /* Visual system refresh: a calm editorial surface with clear stream hierarchy. */
        :root {
            --bg-color: #090b12;
            --card-bg: rgba(20, 25, 40, 0.72);
            --text-main: #f6f7fb;
            --text-sub: #aeb8cb;
            --surface-line: rgba(205, 218, 255, 0.16);
            --accent-ru: #ff6b62;
            --accent-en: #63b2ff;
            --accent-jp: #f58ac2;
        }

        body {
            background:
                radial-gradient(circle at 12% 12%, rgba(80, 123, 255, 0.18), transparent 28rem),
                radial-gradient(circle at 87% 82%, rgba(226, 84, 143, 0.14), transparent 32rem),
                var(--bg-color);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            isolation: isolate;
        }

        body::before {
            background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
            background-size: 2.5rem 2.5rem;
            content: "";
            inset: 0;
            mask-image: linear-gradient(to bottom, black, transparent 76%);
            pointer-events: none;
            position: fixed;
            z-index: -1;
        }

        .container {
            max-width: 70rem;
            position: relative;
        }

        .hero {
            margin: 0 auto 3.25rem;
            max-width: 42rem;
        }

        .eyebrow {
            align-items: center;
            color: #cbd7ff;
            display: flex;
            font-size: 0.7rem;
            font-weight: 800;
            gap: 0.6rem;
            justify-content: center;
            letter-spacing: 0.16em;
            margin: 0 0 0.8rem;
            text-transform: uppercase;
        }

        .eyebrow::before,
        .eyebrow::after {
            background: linear-gradient(90deg, transparent, rgba(203, 215, 255, 0.9));
            content: "";
            height: 1px;
            width: 2.4rem;
        }

        .eyebrow::after {
            transform: scaleX(-1);
        }

        h1 {
            font-size: clamp(3rem, 8vw, 5.6rem);
            letter-spacing: -0.075em;
            line-height: 0.94;
            margin: 0;
            text-shadow: 0 1.25rem 4rem rgba(0, 0, 0, 0.45);
        }

        .subtitle {
            font-size: clamp(1rem, 2vw, 1.18rem);
            line-height: 1.65;
            margin: 1.2rem auto 0;
            max-width: 34rem;
        }

        .lang-grid {
            gap: 1.15rem;
        }

        button.lang-card {
            appearance: none;
            background: linear-gradient(145deg, rgba(35, 43, 67, 0.82), var(--card-bg));
            border: 1px solid var(--surface-line);
            box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.2);
            font: inherit;
            justify-content: flex-start;
            min-height: 17.25rem;
            padding: 2.25rem 1.85rem 1.75rem;
            text-align: center;
        }

        button.lang-card::after {
            background: radial-gradient(circle at 50% 0, rgba(255, 255, 255, 0.16), transparent 54%);
            content: "";
            inset: 0;
            opacity: 0;
            pointer-events: none;
            position: absolute;
            transition: opacity 0.3s ease;
        }

        button.lang-card:hover,
        button.lang-card:focus-visible {
            box-shadow: 0 1.8rem 3.8rem rgba(0, 0, 0, 0.36);
            outline: none;
            transform: translateY(-0.45rem);
        }

        button.lang-card:hover::after,
        button.lang-card:focus-visible::after {
            opacity: 1;
        }

        button.lang-card:focus-visible {
            box-shadow: 0 0 0 0.25rem rgba(236, 241, 255, 0.92), 0 0 0 0.5rem rgba(99, 178, 255, 0.46), 0 1.8rem 3.8rem rgba(0, 0, 0, 0.36);
        }

        button.lang-card:disabled {
            cursor: progress;
            opacity: 0.65;
        }

        .flag-wrapper {
            border: 1px solid rgba(255, 255, 255, 0.16);
            box-shadow: 0 0.85rem 1.8rem rgba(0, 0, 0, 0.28);
            height: 4.25rem;
            margin-bottom: 1.5rem;
            width: 6.35rem;
        }

        .lang-name {
            letter-spacing: -0.035em;
            position: relative;
            z-index: 1;
        }

        .lang-phrase {
            line-height: 1.5;
            margin: 0.4rem auto 0;
            max-width: 15rem;
            position: relative;
            z-index: 1;
        }

        .lang-cta {
            align-items: center;
            color: var(--text-main);
            display: inline-flex;
            font-size: 0.76rem;
            font-weight: 800;
            gap: 0.45rem;
            letter-spacing: 0.04em;
            margin-top: auto;
            padding-top: 1.6rem;
            position: relative;
            text-transform: uppercase;
            z-index: 1;
        }

        .lang-cta::after {
            content: "→";
            font-size: 1.1rem;
            transition: transform 0.2s ease;
        }

        .selection-status {
            color: var(--text-sub);
            font-size: 0.88rem;
            margin: 1.35rem auto 0;
            min-height: 1.5rem;
        }

        .selection-status[data-state="loading"] {
            color: #cbd7ff;
        }

        .selection-status[data-state="error"] {
            color: #ff9b95;
        }

        button.lang-card.is-loading {
            transform: translateY(-0.2rem);
        }

        button.lang-card:hover .lang-cta::after,
        button.lang-card:focus-visible .lang-cta::after {
            transform: translateX(0.25rem);
        }

        @media (max-width: 768px) {
            .hero { margin-bottom: 2.25rem; }
            .eyebrow { font-size: 0.63rem; }
            button.lang-card {
                display: grid;
                grid-template-columns: 4.5rem 1fr;
                min-height: 0;
                padding: 1.35rem;
                text-align: left;
            }
            .flag-wrapper { height: 3rem; margin: 0; width: 4.5rem; }
            .lang-phrase { margin-left: 0; }
            .lang-cta { grid-column: 2; padding-top: 0.8rem; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.01ms !important; scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="hero">
            <p class="eyebrow">Anonymous forum archive</p>
            <h1>TGACH</h1>
            <p class="subtitle">Choose your stream and enter an archive shaped around its language, culture, and community.</p>
        </header>

        <div class="lang-grid" aria-label="Choose a regional stream">
            <!-- RUSSIAN -->
            <button class="lang-card card-ru" type="button" onclick="selectStream('ru', this)" aria-label="Open the Russian stream">
                <div class="flag-wrapper">
                    <svg class="flag-svg" viewBox="0 0 900 600" xmlns="http://www.w3.org/2000/svg">
                        <rect fill="#fff" width="900" height="600"/>
                        <rect fill="#0039a6" y="200" width="900" height="200"/>
                        <rect fill="#d52b1e" y="400" width="900" height="200"/>
                        <!-- Тонкая рамка для белого цвета -->
                        <rect width="900" height="600" fill="none" stroke="rgba(0,0,0,0.1)" stroke-width="2"/>
                    </svg>
                </div>
                <div>
                    <div class="lang-name">Russian</div>
                    <div class="lang-phrase">Я говорю по-русски</div>
                </div>
                <span class="lang-cta">Открыть поток</span>
            </button>

            <!-- ENGLISH (ANIMATED) -->
            <button class="lang-card card-en" type="button" onclick="selectStream('en', this)" aria-label="Open the English stream">
                <div class="flag-wrapper">
                    <div class="flag-slideshow">
                        <!-- US Flag -->
                        <div class="flag-slide">
                            <svg class="flag-svg" viewBox="0 0 1235 650" xmlns="http://www.w3.org/2000/svg">
                                <rect width="1235" height="650" fill="#B22234"/>
                                <path d="M0,0H1235V50H0M0,100H1235V150H0M0,200H1235V250H0M0,300H1235V350H0M0,400H1235V450H0M0,500H1235V550H0M0,600H1235V650H0" fill="#FFF"/>
                                <rect width="494" height="350" fill="#3C3B6E"/>
                            </svg>
                        </div>
                        <!-- UK Flag -->
                        <div class="flag-slide">
                            <svg class="flag-svg" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg">
                                <clipPath id="t"><path d="M30,15h30v15zv15h-30zh-30v-15zv-15h30z"/></clipPath>
                                <path d="M0,0v30h60v-30z" fill="#012169"/>
                                <path d="M0,0l60,30m0-30l-60,30" stroke="#fff" stroke-width="6"/>
                                <path d="M0,0l60,30m0-30l-60,30" clip-path="url(#t)" stroke="#c8102e" stroke-width="4"/>
                                <path d="M30,0v30M0,15h60" stroke="#fff" stroke-width="10"/>
                                <path d="M30,0v30M0,15h60" stroke="#c8102e" stroke-width="6"/>
                            </svg>
                        </div>
                        <!-- EU Flag -->
                        <div class="flag-slide">
                            <svg class="flag-svg" viewBox="0 0 810 540" xmlns="http://www.w3.org/2000/svg">
                                <rect width="810" height="540" fill="#003399"/>
                                <g fill="#ffcc00" transform="matrix(30 0 0 30 405 270)">
                                    <path d="M0-1l-.3.9.95-.3-.95-.3.3.9-.95-.3-.95.3.3-.9L-1.9-.4l.95.3z" id="s"/>
                                    <use xlink:href="#s" y="-6"/>
                                    <use xlink:href="#s" y="6"/>
                                    <use xlink:href="#s" x="-6"/>
                                    <use xlink:href="#s" x="6"/>
                                    <use xlink:href="#s" x="-5.2" y="-3"/>
                                    <use xlink:href="#s" x="5.2" y="-3"/>
                                    <use xlink:href="#s" x="-5.2" y="3"/>
                                    <use xlink:href="#s" x="5.2" y="3"/>
                                    <use xlink:href="#s" x="-3" y="-5.2"/>
                                    <use xlink:href="#s" x="3" y="-5.2"/>
                                    <use xlink:href="#s" x="-3" y="5.2"/>
                                    <use xlink:href="#s" x="3" y="5.2"/>
                                </g>
                            </svg>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="lang-name">English</div>
                    <div class="lang-phrase">I speak English</div>
                </div>
                <span class="lang-cta">Open stream</span>
            </button>

            <!-- JAPANESE -->
            <button class="lang-card card-jp" type="button" onclick="selectStream('jp', this)" aria-label="Open the Japanese stream">
                <div class="flag-wrapper">
                    <svg class="flag-svg" viewBox="0 0 900 600" xmlns="http://www.w3.org/2000/svg">
                        <rect fill="#fff" width="900" height="600"/>
                        <circle fill="#bc002d" cx="450" cy="300" r="180"/>
                        <!-- Тонкая рамка -->
                        <rect width="900" height="600" fill="none" stroke="rgba(0,0,0,0.1)" stroke-width="2"/>
                    </svg>
                </div>
                <div>
                    <div class="lang-name">Japanese</div>
                    <div class="lang-phrase">日本語を話します</div>
                </div>
                <span class="lang-cta">ストリームを開く</span>
            </button>
        </div>
        <p id="stream-status" class="selection-status" role="status" aria-live="polite"></p>
    </div>

    <script>
        async function selectStream(stream, selectedCard) {
            const cards = document.querySelectorAll('.lang-card');
            const status = document.getElementById('stream-status');
            const streamNames = { ru: 'Russian', en: 'English', jp: 'Japanese' };

            cards.forEach((card) => {
                card.disabled = true;
                card.setAttribute('aria-busy', 'true');
            });
            selectedCard.classList.add('is-loading');
            status.dataset.state = 'loading';
            status.textContent = `Opening the ${streamNames[stream]} stream…`;
            
            try {
                const res = await fetch('/api/settings/stream', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ stream: stream })
                });

                if (!res.ok) {
                    throw new Error(`Stream preference request failed with ${res.status}`);
                }

                window.location.assign('/');
            } catch (error) {
                console.warn('Using local stream preference fallback.', error);
                document.cookie = `stream=${stream}; path=/; max-age=31536000; SameSite=Lax`;
                status.dataset.state = 'error';
                status.textContent = 'The server preference could not be saved. Continuing with this browser’s stream preference…';
                window.setTimeout(() => window.location.assign('/'), 900);
            }
        }
    </script>
</body>
</html>