<!DOCTYPE html>
<html lang="{{ request.state.lang or 'ru' }}">
<head>
        <script>
        (function() {
            try {
                var s = JSON.parse(localStorage.getItem('user_settings') || '{}');
                var t = s.theme || localStorage.getItem('theme');
                if (!t) {
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
                    else t = 'light';
                }
                if (t) {
                    document.documentElement.classList.add('theme-' + t);
                }
            } catch (e) {}
        })();
    </script>
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ meta_title }} — ТГАЧ</title>
    <link rel="stylesheet" href="/static/css/style.min.css?v={{ static_version }}">
    <link rel="icon" href="/static/favicon.ico">
    <meta name="description" content="{{ meta_description }}">
    
    <meta property="og:title" content="{{ meta_title }}">
    <meta property="og:description" content="{{ meta_description }}">
    <link rel="canonical" href="{{ request.state.canonical_url }}">
    
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "{{ meta_title }}",
      "description": "{{ meta_description }}",
      "url": "{{ request.url }}"
    }
    </script>
    
    <style>
        .tag-cloud-wrapper {
            background: var(--bg-post);
            padding: 40px 20px;
            border-radius: 12px;
            border: 1px solid var(--border-primary);
            box-shadow: var(--shadow-main);
            text-align: center;
            line-height: 2; /* Увеличил межстрочный интервал для облака */
        }

        .tag-item {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 4px 12px;
            margin: 6px 8px;
            box-sizing: border-box;
            text-decoration: none;
            color: var(--accent-primary);
            transition: all 0.2s ease;
            white-space: nowrap;
            font-weight: 500;
        }

        .tag-item:hover {
            color: var(--accent-link);
            transform: scale(1.1);
            text-shadow: 0 0 10px var(--accent-highlight);
        }

        .tag-count {
            color: var(--text-secondary);
            font-size: 0.6em;
            font-weight: normal;
            vertical-align: super;
            margin-left: 2px;
            opacity: 0.7;
        }

        .tags-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .tags-header h1 {
            border: none;
            font-size: 2.2em;
            margin-bottom: 10px;
        }
    </style>
</head>
<body class="page-tags">
    <header>
        <div class="board-nav-top" spellcheck="false">
            <a href="/">[ {{ request.state.t('nav_home') or 'На главную' }} ]</a>
        </div>
    </header>

    <main>
        <div class="tags-header">
            <h1>🏷️ {{ meta_title }}</h1>
            <p style="color: var(--text-secondary);">Поиск контента по категориям и тегам</p>
        </div>

        <div class="tag-cloud-wrapper">
            {% if tags %}
                {% for tag_name, count in tags %}
                    {# Расчет размера шрифта перенесен сюда, где доступна переменная count #}
                    <a href="/tags/{{ tag_name|replace(' ', '-') }}" 
                       class="tag-item" 
                       style="font-size: clamp(1rem, {{ 1.0 + (count / 200) }}rem, 2.5rem);">
                        #{{ tag_name }}<span class="tag-count">{{ count }}</span>
                    </a>
                {% endfor %}
            {% else %}
                <div class="empty-state" style="margin: 20px auto; border: none; box-shadow: none; background: transparent;">
                    <div class="empty-state-icon">🏷️</div>
                    <div class="empty-state-title">{{ request.state.t('no_tags_title', 'Теги пока не найдены') }}</div>
                    <p class="empty-state-desc">
                        {{ request.state.t('no_tags_found', 'Теги еще не извлечены. Нейро-ядро анализирует контент. Загляните позже или создайте тред с медиа!') }}
                    </p>
                    <div class="empty-state-actions">
                        <a href="/b/" class="btn btn-secondary" style="min-height: 38px; padding: 8px 16px;">📋 В /b/</a>
                        <a href="/" class="btn btn-primary" style="min-height: 38px; padding: 8px 16px;">🏠 На главную</a>
                    </div>
                </div>
            {% endif %}
        </div>
        
        <div style="margin-top: 40px; color: var(--text-secondary); font-size: 0.9em; text-align: center; max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.6;">
            {{ request.state.t('tags_footer_info') or 'Наше нейро-ядро автоматически анализирует каждое видео и изображение, присваивая им релевантные теги для удобной навигации по архиву.' }}
        </div>
    </main>

    <footer>
        <p>&copy; 2026 ТГАЧ. Все права защищены. <br> <small>Индексация тегов обновляется раз в 5 минут.</small></p>
    </footer>

    <script src="/static/js/main.min.js?v=10.3" defer></script>
</body>
</html>